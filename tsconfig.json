{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2021",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": [
    "lib/**/*",
    "api/auth.ts",
    "api/oauth/**/*",
    "api/mcp.ts",
    "api/mcp/enterprise.ts",
    "api/mcp/docs.ts",
    "api/well-known/**/*"
  ],
  "exclude": ["node_modules", "dist", "src", "scripts", "tests"]
}
